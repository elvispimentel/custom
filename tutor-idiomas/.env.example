# Copie para .env.local no desenvolvimento. Na Vercel, cadastre em Settings → Environment Variables.
# Nunca coloque valores reais neste arquivo.

# Senha de acesso ao app (escolha uma longa)
APP_PASSWORD=
# Chave da OpenAI (platform.openai.com → API keys)
OPENAI_API_KEY=
# Supabase do projeto dedicado ao tutor
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que a Vercel envia aos crons (string aleatória longa)
CRON_SECRET=

# Opcionais
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# LIMITE_AUDIO_MIN_DIA=60
# LIMITE_TTS_CARACTERES_DIA=60000
# LIMITE_CHAMADAS_IA_DIA=400
